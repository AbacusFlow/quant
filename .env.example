# 复制为 .env 并填入实际值(.env 已被 gitignore,不会提交)
#
# 这些键决定线上实际跑的策略配置——代码默认值与线上配置不同,
# scripts/daily_local.sh / postclose_local.sh / refresh_report.sh 从这里读出后
# 传给 daily_signal.py / check_risk.py / report_web.py / portfolio_status.py。

# Telegram 推送(BotFather 建 bot 拿 token;chat id 可从 getUpdates 取)
TG_BOT_TOKEN=
TG_CHAT_ID=

# 信号模式: single(本金 <10 万,整仓切换摊薄最低佣金) / ensemble(>=10 万)
SIGNAL_MODE=ensemble
# 账户资金(元)。三个脚本用法不同:
#   daily_signal.py  — 只作兜底,账本能回放出真实资产时用真实资产
#   check_risk.py    — 直接作为回测初始本金,影响整手/最低佣金,进而影响回撤告警基线
#   report_web.py    — 直接作为模拟净值曲线的初始本金
#   portfolio_status.py — 接口对齐,不使用(持仓偏离按真实账本算)
SIGNAL_CAPITAL=100000
# V1 波动率目标覆盖层(true/false)。config.VOL_TARGET_ENABLED 默认 False
SIGNAL_VOL_TARGET=true
# V2 防御 sleeve:残余现金金债各半(true/false)。config.SLEEVE_ENABLED 默认 False
SIGNAL_SLEEVE=true

# 妙想(东方财富)API key,仅收盘后展示档补当日收盘用;缺失则该档静默跳过,
# 不影响任何信号/货币路径
MX_APIKEY=
